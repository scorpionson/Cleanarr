# --- Optional: Radarr / Sonarr integration -------------------------------
# When set, each duplicate copy is labelled with whether Radarr/Sonarr tracks
# it, and Cleanarr refuses to delete the tracked copy unless you force it.
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=yourradarrapikey
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=yoursonarrapikey
# Several instances (e.g. a separate 4K pair): name|type|url|apikey, ";" separated
# ARR_INSTANCES=Radarr4K|radarr|http://radarr4k:7878|key;Sonarr4K|sonarr|http://sonarr4k:8989|key
# ARR_PATH_MATCH_DEPTH=2
# ARR_CACHE_TTL=300
